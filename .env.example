# Task 3 and Task 4 primary provider
OPENAI_API_KEY=replace-with-primary-provider-key
PRIMARY_LLM_URL=https://openrouter.ai/api/v1
PRIMARY_MODEL=qwen/qwen3.8-flash

# Task 4 backup provider
PRIMARY_API_KEY=replace-with-primary-provider-key
BACKUP_LLM_URL=https://api.openai.com/v1
BACKUP_API_KEY=replace-with-backup-provider-key
BACKUP_MODEL=gpt-4o-mini

# Optional Task 4 database path when commands run from the repository root
RATE_LIMIT_DATABASE=task4/db.sqlite3
